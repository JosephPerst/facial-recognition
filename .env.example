# ---- Provider API keys ----
# Pick whichever providers you want to use. At least one is required.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Ollama runs locally; no API key, just the host.
OLLAMA_HOST=http://localhost:11434

# ---- Default provider / model ----
# One of: anthropic, openai, ollama
AGENT_KIT_PROVIDER=anthropic
AGENT_KIT_MODEL=claude-sonnet-4-6
AGENT_KIT_JUDGE_MODEL=claude-sonnet-4-6

# ---- Agent runtime limits ----
AGENT_KIT_MAX_ITERATIONS=25
AGENT_KIT_MAX_COST_USD=5.00
AGENT_KIT_MAX_TOKENS=4096
AGENT_KIT_REQUEST_TIMEOUT=120

# ---- Retry behaviour ----
AGENT_KIT_RETRY_MAX_ATTEMPTS=5
AGENT_KIT_RETRY_INITIAL_DELAY=1.0
AGENT_KIT_RETRY_MAX_DELAY=30.0

# ---- Memory ----
# One of: inmemory, sqlite, chroma, pgvector
AGENT_KIT_MEMORY_BACKEND=sqlite
AGENT_KIT_SQLITE_PATH=./.agent_kit/conversations.db
AGENT_KIT_CHROMA_PATH=./.agent_kit/chroma
AGENT_KIT_PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/agent_kit

# ---- Observability ----
AGENT_KIT_LOG_LEVEL=INFO
AGENT_KIT_LOG_JSON=false
AGENT_KIT_TRACE_FILE=./.agent_kit/traces.jsonl
